.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.env
# raw data is immutable and local; manifest is tracked
data/raw/*
!data/raw/manifest.json
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
models/*.joblib
*.pbix.bak
# local caches
.cache/
# Power BI project local/cache files
dashboard/**/.pbi/
dashboard/**/cache.abf
dashboard/**/localSettings.json
# processed data is fully regenerated by `python scripts/run_pipeline.py` (~4 min) - not committed
data/processed/*
!data/processed/.gitkeep
# build metadata
src/*.egg-info/
