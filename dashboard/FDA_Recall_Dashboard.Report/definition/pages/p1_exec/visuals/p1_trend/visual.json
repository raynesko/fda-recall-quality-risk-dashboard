{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.6.0/schema.json",
  "name": "p1_trend",
  "position": {
    "x": 20,
    "y": 260,
    "z": 8,
    "width": 1240,
    "height": 380,
    "tabOrder": 8
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "month_start"
                }
              },
              "queryRef": "dim_date.month_start",
              "nativeQueryRef": "month_start",
              "displayName": "Report month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_recall_event"
                    }
                  },
                  "Property": "Events Complete Months"
                }
              },
              "queryRef": "fact_recall_event.Events Complete Months",
              "nativeQueryRef": "Events Complete Months",
              "displayName": "Recall events"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_recall_event"
                    }
                  },
                  "Property": "product_type"
                }
              },
              "queryRef": "fact_recall_event.product_type",
              "nativeQueryRef": "product_type",
              "displayName": "Product type"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly recall events by product type (complete months; counts, not rates)'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12.0D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}