table dash_spc

	measure 'SPC Value' =
			VAR s = IF(HASONEVALUE(dash_spc[series]), VALUES(dash_spc[series]), "Drugs - IMPURITY")
			VAR c = IF(HASONEVALUE(dash_spc[chart_label]), VALUES(dash_spc[chart_label]), "Share of month (p-chart)")
			RETURN CALCULATE(SUM(dash_spc[value]), dash_spc[series] = s, dash_spc[chart_label] = c)
		formatString: 0.000

	measure 'SPC CL' =
			VAR s = IF(HASONEVALUE(dash_spc[series]), VALUES(dash_spc[series]), "Drugs - IMPURITY")
			VAR c = IF(HASONEVALUE(dash_spc[chart_label]), VALUES(dash_spc[chart_label]), "Share of month (p-chart)")
			RETURN CALCULATE(SUM(dash_spc[cl]), dash_spc[series] = s, dash_spc[chart_label] = c)
		formatString: 0.000

	measure 'SPC UCL' =
			VAR s = IF(HASONEVALUE(dash_spc[series]), VALUES(dash_spc[series]), "Drugs - IMPURITY")
			VAR c = IF(HASONEVALUE(dash_spc[chart_label]), VALUES(dash_spc[chart_label]), "Share of month (p-chart)")
			RETURN CALCULATE(SUM(dash_spc[ucl]), dash_spc[series] = s, dash_spc[chart_label] = c)
		formatString: 0.000

	measure 'SPC LCL' =
			VAR s = IF(HASONEVALUE(dash_spc[series]), VALUES(dash_spc[series]), "Drugs - IMPURITY")
			VAR c = IF(HASONEVALUE(dash_spc[chart_label]), VALUES(dash_spc[chart_label]), "Share of month (p-chart)")
			RETURN CALCULATE(SUM(dash_spc[lcl]), dash_spc[series] = s, dash_spc[chart_label] = c)
		formatString: 0.000

	measure 'SPC Signal Point' =
			VAR s = IF(HASONEVALUE(dash_spc[series]), VALUES(dash_spc[series]), "Drugs - IMPURITY")
			VAR c = IF(HASONEVALUE(dash_spc[chart_label]), VALUES(dash_spc[chart_label]), "Share of month (p-chart)")
			RETURN CALCULATE(SUM(dash_spc[signal_value]), dash_spc[series] = s, dash_spc[chart_label] = c)
		formatString: 0.000

	measure 'SPC Signals After Baseline' =
			VAR s = IF(HASONEVALUE(dash_spc[series]), VALUES(dash_spc[series]), "Drugs - IMPURITY")
			VAR c = IF(HASONEVALUE(dash_spc[chart_label]), VALUES(dash_spc[chart_label]), "Share of month (p-chart)")
			RETURN CALCULATE(COUNTROWS(dash_spc), dash_spc[series] = s, dash_spc[chart_label] = c, dash_spc[signal] = TRUE(), dash_spc[phase] = "II")
		formatString: 0

	measure 'SPC Selected Series' =
			VAR s = IF(HASONEVALUE(dash_spc[series]), VALUES(dash_spc[series]), "Drugs - IMPURITY")
			VAR c = IF(HASONEVALUE(dash_spc[chart_label]), VALUES(dash_spc[chart_label]), "Share of month (p-chart)")
			RETURN s & " | " & c

	measure 'p-Chart Signals All Monitored' = CALCULATE(COUNTROWS(dash_spc), REMOVEFILTERS(dash_spc), dash_spc[chart] = "p", dash_spc[signal] = TRUE(), dash_spc[phase] = "II")
		formatString: 0

	measure 'Top6 Share' = IF(SELECTEDVALUE(dash_spc[series]) IN {"Drugs - IMPURITY", "Drugs - SPEC_FAIL", "Drugs - STERILITY", "Food - ALLERGEN", "Food - MICRO", "Food - FOREIGN"}, CALCULATE(SUM(dash_spc[value]), dash_spc[chart] = "p"))
		formatString: 0.0%

	measure 'Top6 UCL' = IF(SELECTEDVALUE(dash_spc[series]) IN {"Drugs - IMPURITY", "Drugs - SPEC_FAIL", "Drugs - STERILITY", "Food - ALLERGEN", "Food - MICRO", "Food - FOREIGN"}, CALCULATE(SUM(dash_spc[ucl]), dash_spc[chart] = "p"))
		formatString: 0.0%

	column product_type
		dataType: string
		summarizeBy: none
		sourceColumn: product_type

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column month
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: month

	column n_events
		dataType: int64
		summarizeBy: none
		sourceColumn: n_events

	column month_total
		dataType: int64
		summarizeBy: none
		sourceColumn: month_total

	column chart
		dataType: string
		summarizeBy: none
		sourceColumn: chart

	column value
		dataType: double
		summarizeBy: none
		sourceColumn: value

	column phase
		dataType: string
		summarizeBy: none
		sourceColumn: phase

	column cl
		dataType: double
		summarizeBy: none
		sourceColumn: cl

	column ucl
		dataType: double
		summarizeBy: none
		sourceColumn: ucl

	column lcl
		dataType: double
		summarizeBy: none
		sourceColumn: lcl

	column sigma_z
		dataType: double
		summarizeBy: none
		sourceColumn: sigma_z

	column laney_applied
		dataType: boolean
		summarizeBy: none
		sourceColumn: laney_applied

	column r1
		dataType: boolean
		summarizeBy: none
		sourceColumn: r1

	column r2
		dataType: boolean
		summarizeBy: none
		sourceColumn: r2

	column signal
		dataType: boolean
		summarizeBy: none
		sourceColumn: signal

	column rule_id
		dataType: string
		summarizeBy: none
		sourceColumn: rule_id

	column phase1_removed
		dataType: boolean
		summarizeBy: none
		sourceColumn: phase1_removed

	column monitored
		dataType: boolean
		summarizeBy: none
		sourceColumn: monitored

	column signal_label
		dataType: string
		summarizeBy: none
		sourceColumn: signal_label

	column signal_value
		dataType: double
		summarizeBy: none
		sourceColumn: signal_value

	column chart_label
		dataType: string
		summarizeBy: none
		sourceColumn: chart_label

	column series
		dataType: string
		summarizeBy: none
		sourceColumn: series

	column tooltip
		dataType: string
		summarizeBy: none
		sourceColumn: tooltip

	partition dash_spc = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "dashboard\dash_spc.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"month", type datetime}})
				in
				    Typed
